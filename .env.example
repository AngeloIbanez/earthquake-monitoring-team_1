# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=earthquake_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ingestion Pipeline Settings
INGESTION_LOG_LEVEL=INFO
INGESTION_BATCH_SIZE=500
INGESTION_HISTORICAL_START=2020-01-01
INGESTION_HISTORICAL_END=2024-12-31
INGESTION_MIN_MAGNITUDE=2.5

# Polling Interval (Seconds)
USGS_POLLING_INTERVAL=300
GDACS_POLLING_INTERVAL=900

# Dashboard Settings
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=False
